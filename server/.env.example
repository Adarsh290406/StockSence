# StockSense Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String Format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:@localhost:5432/stocksense

# Security Secret for JWT tokens (Min 32 characters recommended)
JWT_SECRET=stocksense_super_secure_jwt_secret_key_2026_hackathon
